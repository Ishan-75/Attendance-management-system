ENVIRONMENT=development

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./data/attendance.db

# Central MySQL example:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/attendance_db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/attendance_db

# Security & JWT
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long_attendance_system
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","capacitor://localhost","http://localhost"]

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Gmail SMTP Configuration (Production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=attendancesystem55@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM_EMAIL=attendancesystem55@gmail.com
SMTP_FROM_NAME=Attendance Management System
SMTP_USE_TLS=true
